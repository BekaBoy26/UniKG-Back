PORT=5000
# Адрес фронтенда (через запятую, если несколько)
CORS_ORIGIN=http://localhost:3000
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Google AI Studio → Get API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Запасные модели через запятую — используются при перегрузке/лимитах основной
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.1-flash-lite
